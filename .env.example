# Estas variables son OPCIONALES. El sitio funciona sin ellas: lib/supabase.ts
# trae la URL y la clave publicable del proyecto como respaldo.
#
# NO copies este archivo tal cual a Vercel: los valores de abajo son ejemplos
# y una clave incompleta rompe la conexion. O las dejas vacias, o pones el
# valor real que sale de: Supabase > Project Settings > API Keys.
#
# Sirven para apuntar el sitio a OTRA base (por ejemplo una de pruebas) sin
# tocar el codigo.

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_KEY=
# NEXT_PUBLIC_DOMINIO_POR_DEFECTO=
